<Window
    x:Class="FocusPomodoro.HistoryPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FocusPomodoro.ViewModels"
    Title="Histórico">

    <Grid Padding="16,12" Background="#1C1C1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Histórico" />

        <ScrollViewer
            Grid.Row="1"
            Margin="0,12,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryDayItem">
                        <StackPanel Margin="0,0,0,16" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Opacity="0.7"
                                Text="{x:Bind Header}" />
                            <ItemsControl ItemsSource="{x:Bind Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Opacity="0.9"
                                            Text="{x:Bind}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
