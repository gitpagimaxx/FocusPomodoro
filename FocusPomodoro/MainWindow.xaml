<Window
    x:Class="FocusPomodoro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FocusPomodoro">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0" />

        <StackPanel
            Grid.Row="1"
            Padding="12,4,12,10"
            Spacing="10">

            <Grid>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind ViewModel.PhaseAccentBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.CurrentPhaseText, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource FocusMutedBrush}"
                    Text="{x:Bind ViewModel.CycleText, Mode=OneWay}" />
                <Button
                    Width="22"
                    Height="22"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="0.55"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}">
                    <ToolTipService.ToolTip>Configurações</ToolTipService.ToolTip>
                    <FontIcon FontSize="11" Glyph="&#xE713;" />
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleTimerCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryActionTooltip, Mode=OneWay}">
                    <FontIcon
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.PrimaryActionGlyph, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.PhaseAccentBrush, Mode=OneWay}" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    TextAlignment="Right"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="30"
                    FontWeight="Light"
                    Text="{x:Bind ViewModel.TimeRemainingText, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
